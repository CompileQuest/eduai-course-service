datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id              Int               @id
  name            String?           @db.VarChar
  description     String?
  Course_Category Course_Category[]  // One-to-many relation with Course_Category
}

model Course {
  id                  Int      @id @default(autoincrement())
  course_id               String?                @unique @db.VarChar
  thumbnail_url           String?                @db.VarChar
  introduction            String?
  difficulty_level        String?                @db.VarChar
  price                   Decimal?               @db.Decimal
  discounted_price        Decimal?               @db.Decimal
  requirements            String?
  duration                Int?
  introduction_video_link String?                @db.VarChar
  Course_Category         Course_Category[]      // Many-to-many relation with Category
  Course_Description      Course_Description?
  Course_Statistics       Course_Statistics?
  Course_Tags             Course_Tags[]
  FAQ                     FAQ[]
  Review                  Review[]
  Section                 Section[]
  User_Progress_videos    User_Progress_videos[]
}

model Course_Category {
  id          Int       @id
  course_id   Int?
  category_id Int?
  Category    Category? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Course      Course?   @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Course_Description {
  id          Int     @id
  course_id   Int?    @unique
  description String?
  Course      Course? @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Course_Statistics {
  id              Int      @id
  course_id       Int?     @unique
  enrolled_number Int?
  average_rating  Decimal? @db.Decimal
  total_reviews   Int?
  total_sections  Int?
  total_lectures  Int?
  Course          Course?  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Course_Tags {
  id        Int     @id
  course_id Int?
  tag_id    Int?
  Course    Course? @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Tags      Tags?   @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FAQ {
  id        Int     @id
  user_id   Int?
  course_id Int?
  question  String?
  answer    String?
  Course    Course? @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Question {
  id              Int     @id
  quiz_id         Int?
  text            String?
  type            String? @db.VarChar
  options         String?
  correct_answers String?
  Quiz            Quiz?   @relation(fields: [quiz_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Quiz {
  id            Int        @id
  section_id    Int?
  title         String?    @db.VarChar
  passing_score Int?
  description   String?
  Question      Question[]
  Section       Section?   @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Review {
  id         Int       @id
  course_id  Int?
  user_id    Int?
  rating     Decimal?  @db.Decimal
  comment    String?
  created_at DateTime? @db.Timestamptz(6)
  Course     Course?   @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Section {
  id                   Int                    @id
  course_id            Int?
  section_id           String?                @unique @db.VarChar
  section_title        String?                @db.VarChar
  order                Int?
  section_description  String?
  Quiz                 Quiz[]
  Course               Course?                @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_Progress_videos User_Progress_videos[]
  Video                Video[]
}

model Tags {
  id          Int           @id
  name        String?       @unique @db.VarChar
  Course_Tags Course_Tags[]
}

model User_Progress_videos {
  id           Int       @id
  user_id      Int?
  course_id    Int?
  section_id   Int?
  video_id     Int?
  is_completed Boolean?
  completed_at DateTime? @db.Timestamptz(6)
  Course       Course?   @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Section      Section?  @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Video {
  id             Int      @id
  section_id     Int?
  video_id       String?  @unique @db.VarChar
  video_url      String?  @db.VarChar
  video_duration Int?
  is_locked      Boolean?
  is_previewable Boolean?
  Section        Section? @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
