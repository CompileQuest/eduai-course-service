generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id                    String               @id @default(uuid())
  instructorId          String               @map("instructor_id") // Instructor's user ID from the user service
  title                 String?
  thumbnailUrl          String?              @map("thumbnail_url")
  thumbnailPublicId     String?              @map("thumbnail_public_id")
  shortDescription      String?              @map("short_description")
  difficultyLevel       String?              @map("difficulty_level")
  price                 Float?
  discountedPrice       Float?               @map("discounted_price")
  requirements          String?
  duration              Int?
  averageRating         Float?               @default(0) @map("average_rating")
  totalReviews          Int?                 @default(0) @map("total_reviews")
  status                String?
  enrollments           Int                  @default(0) // Simple count of enrollments
  introductionVideoLink String?              @map("introduction_video_link")
  statistics            CourseStatistics?
  sections              Section[]
  reviews               Review[]
  description           String
  WhatWillYouLearn      String?              @map("what_will_you_learn")
  categories            CourseCategory[]
  tags                  CourseTags[]
  userProgressCousre    UserProgressCourse[]
  faqs                  FAQ[]
  deletedAt             DateTime?            @map("deleted_at") // Soft delete field
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
}

model CourseStatistics {
  id                       String    @id @default(uuid())
  courseId                 String    @unique @map("course_id") // Ensuring one-to-one relation with Course
  enrolledNumber           Int?      @map("enrolled_number")
  statisticalAverageRating Float?    @map("statistical_average_rating") // NEW DB COLUMN
  totalReviews             Int?      @map("total_reviews")
  totalSections            Int?      @map("total_sections")
  totalLectures            Int?      @map("total_lectures")
  course                   Course    @relation(fields: [courseId], references: [id])
  deletedAt                DateTime? @map("deleted_at") // Soft delete field

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Category {
  id        String           @id @default(uuid())
  name      String
  courses   CourseCategory[] // Many-to-many relation
  deletedAt DateTime?        @map("deleted_at") // Soft delete field
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
}

model CourseCategory {
  id         String    @id @default(uuid())
  courseId   String    @map("course_id")
  categoryId String    @map("category_id")
  course     Course    @relation(fields: [courseId], references: [id])
  category   Category  @relation(fields: [categoryId], references: [id])
  deletedAt  DateTime? @map("deleted_at") // Soft delete field

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Section {
  id                 String               @id @default(uuid())
  courseId           String               @map("course_id")
  sectionTitle       String               @map("section_title")
  quizId             String?              @map("quiz_id")
  order              Int
  videos             Video[] // One-to-many relation
  files              File[]
  course             Course               @relation(fields: [courseId], references: [id])
  userProgressVideos UserProgressVideos[] // Added relation to UserProgressVideos
  deletedAt          DateTime?            @map("deleted_at") // Soft delete field
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
}

model Video {
  id                String               @id @default(uuid())
  asset_id          String               @unique
  request_id        String? // New field for storing the request_id from Cloudinary
  public_id         String               @unique
  secure_url        String
  playback_url      String?
  sectionId         String               @map("section_id")
  title             String?
  format            String?
  width             Int?
  height            Int?
  duration          Int?
  bitRate           Int?                 @map("bit_rate")
  frameRate         Int?                 @map("frame_rate")
  folder            String?
  audioCodec        String?              @map("audio_codec")
  videoCodec        String?              @map("video_codec")
  video_profile     String?
  notification_type String?
  original_filename String?
  order             Int? // New field for ordering videos
  is_free           Boolean?
  userProgress      UserProgressVideos[]
  section           Section              @relation(fields: [sectionId], references: [id])
  deletedAt         DateTime?            @map("deleted_at") // Soft delete field
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
}

model File {
  id                String    @id @default(uuid())
  asset_id          String    @unique
  request_id        String? // New field for storing the request_id from Cloudinary
  public_id         String    @unique
  secure_url        String
  playback_url      String?
  sectionId         String    @map("section_id")
  title             String?
  format            String?
  bytes             Int?
  type              String?
  etag              String?
  placeholder       Boolean?
  folder            String?
  context           Json? // Store context as JSON
  original_filename String?
  order             Int? // New field for ordering files
  is_free           Boolean?
  section           Section   @relation(fields: [sectionId], references: [id])
  deletedAt         DateTime? @map("deleted_at") // Soft delete field
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
}

model Review {
  id        String    @id @default(uuid())
  courseId  String    @map("course_id")
  userId    String    @map("user_id")
  rating    Float?
  comment   String?
  course    Course    @relation(fields: [courseId], references: [id])
  deletedAt DateTime? @map("deleted_at") // Soft delete field
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}

model FAQ {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  courseId  String    @map("course_id")
  question  String
  answer    String
  course    Course    @relation(fields: [courseId], references: [id])
  deletedAt DateTime? @map("deleted_at") // Soft delete field
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}

model Tags {
  id        String       @id @default(uuid())
  name      String       @unique
  courses   CourseTags[] // Many-to-many relation
  deletedAt DateTime?    @map("deleted_at") // Soft delete field
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
}

model CourseTags {
  id        String    @id @default(uuid())
  courseId  String    @map("course_id")
  tagId     String    @map("tag_id")
  course    Course    @relation(fields: [courseId], references: [id])
  tag       Tags      @relation(fields: [tagId], references: [id])
  deletedAt DateTime? @map("deleted_at") // Soft delete field
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}

model UserProgressVideos {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  sectionId   String    @map("section_id")
  videoId     String    @map("video_id")
  isCompleted Boolean   @map("is_completed")
  completedAt DateTime? @map("completed_at")
  section     Section   @relation(fields: [sectionId], references: [id])
  video       Video     @relation(fields: [videoId], references: [id])
  deletedAt   DateTime? @map("deleted_at") // Soft delete field
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
}

model UserProgressCourse {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  isCompleted Boolean   @map("is_completed")
  completedAt DateTime? @map("completed_at")
  course      Course    @relation(fields: [courseId], references: [id])
  deletedAt   DateTime? @map("deleted_at") // Soft delete field
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
}
